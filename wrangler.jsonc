{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "instagram-dm-auto-reply",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "instagram-dm-db",
      "database_id": "5f728e04-8afc-40a5-a9c7-b4331befd88d"
    }
  ]
}
